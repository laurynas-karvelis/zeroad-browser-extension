{
  "root": {
    "homepage_url": "https://zeroad.network",
    "extension_name": "browser-extension",
    "name": "Zero Ad Network",
    "description": "Ad-free browsing and included paid content on participating sites. Support publishers with one paid Freedom membership.",
    "permissions": ["scripting", "declarativeNetRequest", "webRequest", "storage", "alarms", "tabs", "idle"],
    "popup": {
      "default_popup": "popup.html"
    },
    "background_script": "js/worker.js",
    "hosts": ["https://*/*", "http://*/*"],
    "external_matches": ["https://zeroad.network/*"]
  },
  "chrome": {
    "manifest_version": 3,
    "version": "${root.version}",
    "homepage_url": "${root.homepage_url}",
    "name": "${root.name}",
    "description": "${root.description}",
    "icons": { "128": "images/logo.png" },
    "permissions": { "$eval": "root.permissions" },
    "host_permissions": { "$eval": "root.hosts" },
    "action": {
      "default_popup": "${root.popup.default_popup}",
      "default_icon": { "128": "images/logo-gray.png" }
    },
    "background": {
      "service_worker": "${root.background_script}",
      "type": "module"
    },
    "externally_connectable": {
      "matches": { "$eval": "root.external_matches" }
    }
  },
  "firefox": {
    "manifest_version": 3,
    "version": "${root.version}",
    "homepage_url": "${root.homepage_url}",
    "name": "${root.name}",
    "description": "${root.description}",
    "icons": { "48": "images/logo.svg" },
    "permissions": { "$eval": "root.permissions" },
    "host_permissions": { "$eval": "root.hosts" },
    "background": {
      "scripts": ["${root.background_script}"]
    },
    "action": {
      "default_popup": "${root.popup.default_popup}",
      "default_icon": { "48": "images/logo-gray.svg" }
    },
    "content_scripts": [
      {
        "matches": { "$eval": "root.external_matches" },
        "js": ["js/content.js"]
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "${root.extension_name}@zeroad.network",
        "data_collection_permissions": {
          "required": ["authenticationInfo", "browsingActivity", "websiteContent"]
        }
      }
    }
  }
}
